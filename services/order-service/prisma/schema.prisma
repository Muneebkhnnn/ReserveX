generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  ticketId  String
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FAILED
}

// Transactional outbox: written in the SAME db transaction as the Order row.
// A relay process separately reads unpublished rows and pushes them to BullMQ.
// This is what avoids the dual-write problem — without it, you'd either risk
// "order saved but notification never queued" or "notification sent but order
// row never committed", depending on which write you do first.
model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt])
}
